{
  "name": "@hilda-biz/dsh-procurement-intake",
  "version": "0.1.10",
  "private": true,
  "type": "module",
  "license": "MIT",
  "icon": "./assets/plugin-icon.png",
  "engines": {
    "dsh": ">=0.2.1-rc.1 <0.3.0"
  },
  "description": "DeepSeek Harness extension for importing procurement requisitions and purchase orders.",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./typert": "./typert.host.js",
    "./remote": "./typert.remote-client.js"
  },
  "files": [
    "index.js",
    "src/",
    "dist/",
    "client.js",
    "cordis.patch.yml",
    "remote-def.js",
    "typert.host.js",
    "typert.remote-client.js",
    "locale/",
    "assets/",
    "vendor/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "scripts": {
    "build": "npm run lint && node build-host.mjs && node build-client.mjs",
    "build:ai-table": "npm run typecheck:ai-table && cd vendor/ai-table && vite build && node scripts/scope-css.mjs",
    "typecheck:ai-table": "tsc -p vendor/ai-table/tsconfig.json",
    "lint": "eslint \"src/**/*.{js,cjs}\""
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "date-fns": "^4.4.0",
    "react-day-picker": "^10.0.2",
    "recharts": "^3.10.1",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-storage-domain": ">=0.2.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.1-rc.1 <0.3.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.1-rc.1 <0.3.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@tailwindcss/vite": "4.3.2",
    "@tanstack/react-table": "8.21.3",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "lucide-react": "1.22.0",
    "postcss": "8.5.6",
    "radix-ui": "1.6.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.2",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.2",
    "vite": "8.1.0"
  }
}
