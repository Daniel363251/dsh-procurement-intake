{
  "name": "@hilda-biz/dsh-procurement-intake",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "license": "MIT",
  "icon": "./assets/plugin-icon.png",
  "engines": {
    "dsh": ">=0.2.1-rc.1 <0.3.0"
  },
  "description": "DeepSeek Harness extension for importing procurement requisitions and purchase orders.",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./typert": "./typert.host.js",
    "./remote": "./typert.remote-client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "remote-def.js",
    "typert.host.js",
    "typert.remote-client.js",
    "locale/",
    "assets/",
    "vendor/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "scripts": {
    "build": "node build-client.mjs"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "date-fns": "^4.4.0",
    "react-day-picker": "^10.0.2",
    "recharts": "^3.10.1",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-storage-domain": ">=0.2.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.1-rc.1 <0.3.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.1-rc.1 <0.3.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.25.0",
    "i18next": "26.3.6",
    "lucide-react": "1.22.0",
    "radix-ui": "1.6.0",
    "react-i18next": "17.0.10",
    "tailwind-merge": "3.6.0"
  }
}
